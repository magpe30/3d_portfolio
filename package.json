    "autoprefixer": "^10.4.13",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "playwright": "^1.64.1",
    "postcss": "^8.4.21",
